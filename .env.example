# यही Supabase project जो आपकी वेबसाइट इस्तेमाल करती है
# (web app के .env में VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY जैसी वैल्यू)
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# लोकल पर टेस्ट करने के लिए: इस फाइल को .env के नाम से कॉपी करें और असली वैल्यू भरें।
# GitHub Actions से APK बिल्ड करने के लिए: इन्हें repo Settings > Secrets and
# variables > Actions में SUPABASE_URL और SUPABASE_ANON_KEY नाम से जोड़ें।
